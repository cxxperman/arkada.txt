     const isDocumentVisible = () => !win?.closed && doc.visibilityState !== 'hidden';
 
+    /*
+     * The poll's turn comes at the start of a frame, not from the timer itself. Its `active` check
+     * is mostly SE.visible(), and checkVisibility() needs the styles up to date: from a timer, while
+     * the page is changing (a game page builds itself for 1-2 s), that forced a style pass of the
+     * whole window on top of the frame's own (up to ~145 ms each, 171 ms in all on one page change).
+     * At the start of a frame it is the frame's one pass, done a little earlier.
+     */
+    let frame = 0;
+    const tickInFrame = () => {
+      if (frame) return;
+      if (!win?.requestAnimationFrame) {
+        tick();
+        return;
+      }
+      frame = win.requestAnimationFrame(() => {
+        frame = 0;
+        tick();
+      });
+    };
